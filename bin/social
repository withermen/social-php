<?php

use Social\App;
use Social\Exceptions\ApiException;
use Social\Http\Request;
use Social\Support\Config;
use Social\Support\Str;

require __DIR__ . '/../autoload.php';

function writeEnvValues(string $path, array $values): void
{
    if (!is_file($path)) {
        $template = __DIR__ . '/../.env.example';
        file_put_contents($path, is_file($template) ? file_get_contents($template) : '');
    }

    $lines = file($path, FILE_IGNORE_NEW_LINES) ?: [];
    $remaining = $values;

    foreach ($lines as $index => $line) {
        if (!str_contains($line, '=') || str_starts_with(trim($line), '#')) {
            continue;
        }

        $name = trim(substr($line, 0, strpos($line, '=')));

        if (array_key_exists($name, $values)) {
            $lines[$index] = $name . '=' . $values[$name];
            unset($remaining[$name]);
        }
    }

    foreach ($remaining as $name => $value) {
        $lines[] = $name . '=' . $value;
    }

    file_put_contents($path, implode(PHP_EOL, $lines) . PHP_EOL);
}

function cliOption(array $argv, string $name, ?string $default = null): ?string
{
    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--' . $name . '=')) {
            return substr($argument, strlen($name) + 3);
        }
    }

    return $default;
}

$app = new App(Config::load(__DIR__ . '/../config/social.php'));
$command = $argv[1] ?? 'help';

try {
    switch ($command) {
        case 'migrate':
            $app->db()->migrate();
            echo 'Database is up to date.' . PHP_EOL;
            break;

        case 'create-admin':
            $username = $argv[2] ?? '';
            $email = $argv[3] ?? '';
            $password = $argv[4] ?? '';
            $display = $argv[5] ?? $username;

            if ($username === '' || $email === '' || $password === '') {
                throw new RuntimeException('Usage: php bin/social create-admin <username> <email> <password> [display name]');
            }

            $request = new Request('POST', '/api/v1/auth/register', [], [], '', [], ['REMOTE_ADDR' => '127.0.0.1']);
            $result = $app->auth()->register([
                'username' => $username,
                'email' => $email,
                'password' => $password,
                'display_name' => $display,
            ], $request);
            $app->db()->update('users', ['role' => 'admin', 'email_verified_at' => Str::now()], 'id = ?', [$result['user']['id']]);
            echo 'Admin created: @' . $result['user']['username'] . PHP_EOL;
            break;

        case 'seed':
            $accounts = [
                ['alice', 'alice@example.com', 'password123', 'Alice'],
                ['bob', 'bob@example.com', 'password123', 'Bob'],
                ['charlie', 'charlie@example.com', 'password123', 'Charlie'],
            ];
            $request = new Request('POST', '/api/v1/auth/register', [], [], '', [], ['REMOTE_ADDR' => '127.0.0.1']);

            foreach ($accounts as [$username, $email, $password, $display]) {
                try {
                    $result = $app->auth()->register([
                        'username' => $username,
                        'email' => $email,
                        'password' => $password,
                        'display_name' => $display,
                    ], $request);
                    echo 'Created @' . $result['user']['username'] . PHP_EOL;
                } catch (ApiException $exception) {
                    echo 'Skipped @' . $username . ': ' . $exception->getMessage() . PHP_EOL;
                }
            }

            $alice = $app->users()->byUsername('alice');
            $bob = $app->users()->byUsername('bob');
            $charlie = $app->users()->byUsername('charlie');
            $app->users()->follow($bob, 'alice');
            $app->users()->follow($charlie, 'alice');
            $app->users()->follow($alice, 'bob');
            echo 'Demo accounts ready with password: password123' . PHP_EOL;
            break;

        case 'prune':
            $tokens = $app->db()->run('DELETE FROM refresh_tokens WHERE expires_at < ? OR revoked_at < ?', [Str::now(-86400), Str::now(-604800)]);
            $verifications = $app->db()->run('DELETE FROM verification_tokens WHERE expires_at < ?', [Str::now(-86400)]);
            $limits = $app->db()->run('DELETE FROM rate_limits WHERE window_start < ?', [time() - 86400]);
            $sessions = $app->db()->run("DELETE FROM upload_sessions WHERE status = 'aborted' AND updated_at < ?", [Str::now(-86400)]);
            $notifications = $app->db()->run('DELETE FROM notifications WHERE created_at < ?', [Str::now(-7776000)]);
            echo 'Pruned tokens: ' . $tokens->rowCount()
                . ', verifications: ' . $verifications->rowCount()
                . ', rate limits: ' . $limits->rowCount()
                . ', uploads: ' . $sessions->rowCount()
                . ', notifications: ' . $notifications->rowCount() . PHP_EOL;
            break;

        case 'stats':
            $stats = $app->admin()->stats();
            echo json_encode($stats, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
            break;

        case 'install':
        case 'plan':
            $plan = strtolower((string) cliOption($argv, 'plan', $command === 'plan' ? ($argv[2] ?? 'free') : 'free'));

            if (!in_array($plan, ['free', 'commercial'], true)) {
                throw new RuntimeException('Plan must be free or commercial.');
            }

            $values = [
                'SOCIAL_PLAN' => $plan,
                'LICENSING_MODE' => $plan === 'free' ? 'off' : 'remote',
                'LICENSING_ENABLED' => $plan === 'free' ? 'false' : 'true',
                'LICENSING_ENFORCEMENT' => $plan === 'free' ? 'off' : 'enforce',
            ];

            if ($plan === 'free') {
                $values['ADS_ENABLED'] = 'false';
                $values['PLATFORM_MODE'] = 'long';
            }

            foreach (['domain' => 'LICENSE_DOMAIN', 'server' => 'LICENSE_SERVER_URL', 'public-key' => 'LICENSE_SERVER_PUBLIC_KEY', 'key' => 'LICENSE_KEY'] as $option => $envName) {
                $value = cliOption($argv, $option);

                if ($value !== null && $value !== '') {
                    $values[$envName] = $value;
                }
            }

            writeEnvValues(__DIR__ . '/../.env', $values);
            echo 'Plan set to ' . $plan . '. Restart the service for changes to apply.' . PHP_EOL;

            if ($plan === 'commercial') {
                echo 'Required: LICENSE_SERVER_URL, LICENSE_SERVER_PUBLIC_KEY, LICENSE_DOMAIN, LICENSE_KEY.' . PHP_EOL;
            }

            break;

        case 'license-key':
            $key = trim((string) ($argv[2] ?? ''));

            if ($key === '') {
                throw new RuntimeException('Usage: php bin/social license-key <license key>');
            }

            writeEnvValues(__DIR__ . '/../.env', ['LICENSE_KEY' => $key]);
            echo 'License key saved. Run: php bin/social license-check' . PHP_EOL;
            break;

        case 'integrity':
            $manifest = $app->integrity()->build();
            echo 'Integrity manifest written: ' . count($manifest['files']) . ' files.' . PHP_EOL;
            break;

        case 'license-check':
            $result = $app->remoteLicense()->refresh(true);
            echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
            break;

        case 'help':
            echo 'SocialPHP CLI' . PHP_EOL
                . '  php bin/social migrate' . PHP_EOL
                . '  php bin/social install --plan=free|commercial [--domain=example.com] [--server=https://kerem.site/api/lisans] [--public-key=BASE64] [--key=LICENSE-KEY]' . PHP_EOL
                . '  php bin/social plan free|commercial' . PHP_EOL
                . '  php bin/social license-key <license key>' . PHP_EOL
                . '  php bin/social license-check' . PHP_EOL
                . '  php bin/social integrity' . PHP_EOL
                . '  php bin/social seed' . PHP_EOL
                . '  php bin/social create-admin <username> <email> <password> [display name]' . PHP_EOL
                . '  php bin/social prune' . PHP_EOL
                . '  php bin/social stats' . PHP_EOL;
            break;

        default:
            fwrite(STDERR, 'Unknown command: ' . $command . PHP_EOL);
            exit(1);
    }
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}
