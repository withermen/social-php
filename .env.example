APP_NAME=SocialPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=replace-this-with-a-long-random-secret

DB_DRIVER=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social
DB_USER=root
DB_PASSWORD=

AUTH_ACCESS_TTL=3600
AUTH_REFRESH_TTL=2592000
AUTH_EXPOSE_TOKENS=false

STORAGE_DRIVER=local
STORAGE_ROOT=
STORAGE_URL=/media

UPLOAD_MAX_SIZE=536870912
UPLOAD_MAX_CHUNK=8388608
UPLOAD_MAX_DURATION=600

MEDIA_FFMPEG=ffmpeg
MEDIA_FFPROBE=ffprobe
MEDIA_TIMEOUT=30

MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_LOG_PATH=

CORS_ALLOWED_ORIGINS=*
TRUST_PROXY=false
