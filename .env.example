APP_NAME=SocialPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=replace-this-with-a-long-random-secret

DB_DRIVER=sqlite
DB_DATABASE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social
DB_USER=root
DB_PASSWORD=

AUTH_ACCESS_TTL=3600
AUTH_REFRESH_TTL=2592000
AUTH_EXPOSE_TOKENS=false

STORAGE_DRIVER=local
STORAGE_ROOT=
STORAGE_URL=/media

UPLOAD_MAX_SIZE=536870912
UPLOAD_MAX_CHUNK=8388608
UPLOAD_MAX_DURATION=600

MEDIA_FFMPEG=ffmpeg
MEDIA_FFPROBE=ffprobe
MEDIA_TIMEOUT=30

MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_LOG_PATH=

PLATFORM_MODE=hybrid
PLATFORM_SHORT_MAX_DURATION=180
PLATFORM_LONG_MIN_DURATION=180
PLATFORM_ENFORCE_UPLOAD_MODE=true

ANALYSIS_ENABLED=true
ANALYSIS_FRAME_SAMPLES=5
ANALYSIS_FRAME_WIDTH=160
ANALYSIS_SCENE_THRESHOLD=0.32
ANALYSIS_MAX_TOPICS=14
ANALYSIS_INTEREST_HALF_LIFE_DAYS=45

FEED_RETENTION_WEIGHT=5.4
FEED_EXPECTED_WATCH_WEIGHT=2.6
FEED_REWATCH_WEIGHT=1.8
FEED_HOOK_WEIGHT=3.4
FEED_ENGAGEMENT_WEIGHT=2.0
FEED_SKIP_PENALTY=9.0
FEED_EXPLORATION_WEIGHT=1.7
FEED_EXPLORATION_RATE=0.16
FEED_EXPLORATION_MIN_IMPRESSIONS=8
FEED_SESSION_WINDOW_MINUTES=45
FEED_COMPLETION_RATIO=0.9
FEED_SKIP_RATIO=0.25
FEED_MAX_PER_AUTHOR=2
FEED_MAX_AUTHOR_TOTAL=4
FEED_MAX_SAME_TOPIC=2

ADS_ENABLED=true
ADS_FREQUENCY_PER_HOUR=12
ADS_DEFAULT_CPM_CENTS=450
ADS_DEFAULT_CPC_CENTS=25
ADS_MIN_BUDGET_CENTS=1000
ADS_REQUIRE_APPROVAL=false

PREMIUM_ALLOW_DIRECT_SUBSCRIBE=true
PREMIUM_PLUS_PRICE_CENTS=499
PREMIUM_PRO_PRICE_CENTS=1299

PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=

LICENSING_ENABLED=false
LICENSING_ENFORCEMENT=off
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=
LICENSE_ISSUER=SocialPHP
LICENSE_WEBHOOK_SECRET=
LICENSE_COMMERCIAL_PRICE_CENTS=14900
LICENSE_ENTERPRISE_PRICE_CENTS=49900
LICENSE_CURRENCY=USD
LICENSE_COMMERCIAL_DURATION_DAYS=365
LICENSE_ENTERPRISE_DURATION_DAYS=365
LICENSE_COMMERCIAL_MAX_ACTIVATIONS=3
LICENSE_ENTERPRISE_MAX_ACTIVATIONS=20

CORS_ALLOWED_ORIGINS=*
TRUST_PROXY=false
